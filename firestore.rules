rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(familyId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    // Профілі користувачів: читати може будь-хто автентифікований (потрібно для
    // відображення імен у чаті), редагувати — тільки власний профіль.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Сім'ї: читати можуть тільки учасники; створювати може будь-хто автентифікований
    // (стає власником); додавати себе в members можна тільки через приєднання за кодом
    // (обмежено тим, що клієнт може лише додати власний uid).
    match /families/{familyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
        request.resource.data.members.hasAll(resource.data.members) &&
        request.resource.data.members.size() == resource.data.members.size() + 1 &&
        request.auth.uid in request.resource.data.members;
      allow delete: if false;
    }

    // Чати: доступні тільки учасникам родини
    match /chats/{chatId} {
      allow read: if isSignedIn() && isMember(resource.data.familyId);
      allow create: if isSignedIn() && isMember(request.resource.data.familyId);
      allow update: if isSignedIn() && isMember(resource.data.familyId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() && isMember(get(/databases/$(database)/documents/chats/$(chatId)).data.familyId);
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          isMember(get(/databases/$(database)/documents/chats/$(chatId)).data.familyId);
        allow update: if isSignedIn() && isMember(get(/databases/$(database)/documents/chats/$(chatId)).data.familyId);
        allow delete: if false;
      }
    }
  }
}
