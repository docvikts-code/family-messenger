rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Медіа доступні лише автентифікованим користувачам застосунку.
    // (Точнішу перевірку "той самий familyId" додати складніше без Firestore-look-up
    // у Storage rules — на MVP-етапі достатньо автентифікації + невгадуваних шляхів.)
    match /families/{chatId}/media/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.size < 100 * 1024 * 1024 && // ліміт 100MB на файл
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType.matches('video/.*'));
    }
  }
}
